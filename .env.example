# === 認證 ===
JWT_SECRET=change-me-to-a-long-random-string
JWT_EXPIRE_HOURS=72
# 上線（HTTPS）時設 true
COOKIE_SECURE=false

# === 資料庫 ===
# sqlite（免安裝，開箱即用，測試預設）；mysql（搭配 docker-compose.yml / sql/schema.sql）
DB_BACKEND=sqlite
SQLITE_PATH=./data/app.db
# DB_BACKEND=mysql 時使用（docker-compose 預設如下）：
MYSQL_HOST=127.0.0.1
MYSQL_PORT=3307
MYSQL_USER=root
MYSQL_PASSWORD=devroot
MYSQL_DB=portfolio_health

# === 股價資料來源 ===
# synthetic：離線合成資料（展示 / 測試，免金鑰）
# finmind：真實台股資料（需 FINMIND_TOKEN）
PRICE_SOURCE=synthetic
FINMIND_TOKEN=
# 還原股價資料集。TaiwanStockPriceAdj 需 FinMind 付費方案（backer/sponsor）。
# 免費 token 可暫設 TaiwanStockPrice（未還原，除息日會失真，正式不可用）。
FINMIND_PRICE_DATASET=TaiwanStockPriceAdj
BACKFILL_YEARS=2

# === 財報資料來源（財報變動偵測模組 SPEC-anomaly）===
# synthetic：離線合成財報（展示 / 測試，免金鑰，可完整端到端跑）
# finmind：真實財報（需 FINMIND_TOKEN）。⚠️ 季報偵測在完成 A-02（填好 ITEM_MAP、
#          確認現金流是否累計）前無法啟用，月營收偵測不受此限。
FUNDAMENTALS_SOURCE=synthetic
# 健檢「基本面提醒」只看最近幾個月內的旗標
ANOMALY_ALERT_MONTHS=6

# === RAG AI 解讀（SPEC-anomaly §10）===
# 新聞來源：synthetic（離線合成，預設）| finmind（真實 TaiwanStockNews，需 token；此 token 版本只回標題無內文）
NEWS_SOURCE=synthetic
# embedding 與 LLM 共用 Gemini 金鑰（LLM_PROVIDER=gemini 時）；無金鑰自動退回本地雜湊向量
EMBEDDING_MODEL=gemini-embedding-001
RAG_TOP_K=8
# 新聞時間窗（天）與單旗標最多抓幾天（控成本）；真實抓取每次請求間隔 NEWS_THROTTLE_SEC 秒
NEWS_WINDOW_BEFORE=14
NEWS_WINDOW_AFTER=3
NEWS_MAX_DAYS=20
NEWS_THROTTLE_SEC=1.5
MAX_EXPLAIN_PER_DAY=20

# === LLM（留空則自動走規則式備援報告）===
# none | openai | gemini
LLM_PROVIDER=none
LLM_MODEL=
OPENAI_API_KEY=
GEMINI_API_KEY=
LLM_TEMPERATURE=0.3

# === 風險引擎 ===
RISK_FREE_RATE=0.015

# === 成本控制 ===
MAX_REPORTS_PER_DAY=10
